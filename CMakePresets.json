{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "EASYCON_BUILD_COMPONENT_TESTS": "ON"
      },
      "environment": {
        "VCPKG_FEATURE_FLAGS": "manifests,registries,versions"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "msvc-debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "msvc-release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "clang-asan",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "EASYCON_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "clang-ubsan",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "EASYCON_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "clang-tidy",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "EASYCON_ENABLE_CLANG_TIDY": "ON",
        "EASYCON_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "msvc-analyze",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "EASYCON_ENABLE_MSVC_ANALYZE": "ON"
      }
    },
    {
      "name": "clang-fuzz",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "EASYCON_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-x64-debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-x64-release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-x64-asan",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "EASYCON_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "linux-x64-ubsan",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "EASYCON_ENABLE_UBSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "clang-asan", "configurePreset": "clang-asan" },
    { "name": "clang-ubsan", "configurePreset": "clang-ubsan" },
    { "name": "clang-tidy", "configurePreset": "clang-tidy" },
    { "name": "msvc-analyze", "configurePreset": "msvc-analyze" },
    { "name": "clang-fuzz", "configurePreset": "clang-fuzz" },
    { "name": "linux-x64-debug", "configurePreset": "linux-x64-debug" },
    { "name": "linux-x64-release", "configurePreset": "linux-x64-release" },
    { "name": "linux-x64-asan", "configurePreset": "linux-x64-asan" },
    { "name": "linux-x64-ubsan", "configurePreset": "linux-x64-ubsan" }
  ],
  "testPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-asan",
      "configurePreset": "clang-asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-ubsan",
      "configurePreset": "clang-ubsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-fuzz",
      "configurePreset": "clang-fuzz",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-x64-asan",
      "configurePreset": "linux-x64-asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-x64-ubsan",
      "configurePreset": "linux-x64-ubsan",
      "output": { "outputOnFailure": true }
    }
  ]
}
