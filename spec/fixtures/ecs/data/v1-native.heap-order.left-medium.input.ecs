$template = ""
$baseline = [$template]
FOR $i = 1 TO 131
    $baseline = APPEND($baseline, $template[0:251000])
NEXT

FUNC LEFT($source) : string
    $full = $source[0:251000]
    RETURN $full[0:1]
ENDFUNC

FUNC MEDIUM($source) : string
    RETURN $source[0:200000]
ENDFUNC

$result = LEFT($template) + MEDIUM($template)
