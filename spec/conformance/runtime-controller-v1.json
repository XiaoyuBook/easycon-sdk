{
  "schema_version": 1,
  "milestone": "runtime-controller-fake-v1",
  "license": "GPL-3.0-only",
  "scenarios": [
    {
      "id": "vertical-slice",
      "test": "tests/support/tests/vertical_slice.rs::runtime_controller_fake_vertical_slice_has_exact_trace_and_clean_shutdown",
      "tests": [
        "tests/support/tests/vertical_slice.rs::runtime_controller_fake_vertical_slice_has_exact_trace_and_clean_shutdown",
        "tests/support/tests/controller_lane.rs::fallback_connect_partial_direct_and_close_are_exact"
      ],
      "steps": [
        { "id": "vertical.runtime-create", "action": "create Runtime with VirtualClock" },
        { "id": "vertical.subscribe", "action": "subscribe to bounded events" },
        { "id": "vertical.controller-create", "action": "create fake Controller transport" },
        { "id": "vertical.connect", "action": "connect at 115200 with hello response" },
        { "id": "vertical.direct", "action": "submit direct action and observe transport acceptance" },
        { "id": "vertical.sequence", "action": "submit precise sequence with absolute offsets" },
        { "id": "vertical.cancel", "action": "cancel before a future step and accept neutral report" },
        { "id": "vertical.close-twice", "action": "close Runtime twice" },
        { "id": "vertical.drain", "action": "drain RuntimeClosed and close subscription" },
        { "id": "vertical.post-close-publish", "action": "attempt an event publish after RuntimeClosed" }
      ],
      "assertions": [
        {
          "id": "vertical.operation-transitions",
          "expect": "operation states and events follow the canonical transitions",
          "test": "tests/support/tests/vertical_slice.rs::runtime_controller_fake_vertical_slice_has_exact_trace_and_clean_shutdown"
        },
        {
          "id": "vertical.report-trace",
          "expect": "report bytes and virtual timestamps match tracked fixtures",
          "test": "tests/support/tests/vertical_slice.rs::runtime_controller_fake_vertical_slice_has_exact_trace_and_clean_shutdown"
        },
        {
          "id": "vertical.transport-boundary",
          "expect": "direct success claims transport acceptance only",
          "test": "tests/support/tests/controller_lane.rs::fallback_connect_partial_direct_and_close_are_exact"
        },
        {
          "id": "vertical.closed-counts",
          "expect": "active operation, task, and resource counts are zero after every successful close",
          "test": "tests/support/tests/vertical_slice.rs::runtime_controller_fake_vertical_slice_has_exact_trace_and_clean_shutdown"
        },
        {
          "id": "vertical.final-event-order",
          "expect": "RuntimeClosed occurs after worker join and registry convergence and post-close event production is rejected",
          "test": "tests/support/tests/vertical_slice.rs::runtime_controller_fake_vertical_slice_has_exact_trace_and_clean_shutdown"
        }
      ]
    },
    {
      "id": "runtime-stabilization",
      "test": "crates/easycon-runtime/src/runtime.rs::resource_panic_saves_one_report_without_forcing_owner_terminal",
      "tests": [
        "crates/easycon-runtime/src/runtime.rs::task_close_without_manual_binding_does_not_self_wait",
        "crates/easycon-runtime/src/runtime.rs::task_exit_destructor_close_is_rejected_before_state_change",
        "crates/easycon-runtime/src/runtime.rs::task_exit_destructor_cannot_join_its_own_thread",
        "crates/easycon-runtime/src/runtime.rs::concurrent_external_join_cannot_hide_a_task_panic_from_close",
        "crates/easycon-runtime/src/runtime.rs::resource_callback_reentrant_close_is_rejected_without_self_wait",
        "crates/easycon-runtime/src/runtime.rs::final_owning_drop_only_rejects_admission_and_requests_cancellation",
        "crates/easycon-runtime/src/runtime.rs::resource_panic_saves_one_report_without_forcing_owner_terminal",
        "crates/easycon-runtime/src/runtime.rs::final_event_failure_never_exposes_runtime_closed"
      ],
      "steps": [
        { "id": "runtime.spawn-self-close", "action": "spawn a supervised task through Runtime and call synchronous close from its task body" },
        { "id": "runtime.task-exit-destructor", "action": "call close and self-join from task-owned TLS destructors after the body completion signal" },
        { "id": "runtime.task-panic-race", "action": "pause an external panic-task join at registry unlink while another thread closes Runtime" },
        { "id": "runtime.resource-reentrant-close", "action": "re-enter synchronous Runtime close from a ManagedResource callback on the deterministic close owner thread" },
        { "id": "runtime.external-close", "action": "close the same Runtime externally after the supervised task exits" },
        { "id": "runtime.final-drop", "action": "drop the final owning handle of a fresh Runtime with a live resource and subscription" },
        { "id": "runtime.drop-observe", "action": "observe admission rejection and root cancellation without releasing the resource owner" },
        { "id": "runtime.resource-panic", "action": "explicitly close another Runtime whose first resource callback panics and whose healthy resource can close" },
        { "id": "runtime.failed-owner-cleanup", "action": "hold the failed resource owner task in cleanup while concurrent close callers wait" },
        { "id": "runtime.finish-real-cleanup", "action": "finish the real owner cleanup after every close caller receives the saved outcome" },
        { "id": "runtime.final-event-failure", "action": "fail final-event preflight for the second subscription before atomically committing any Runtime final event" },
        { "id": "runtime.repeat-close-failed", "action": "call close again after CloseFailed" }
      ],
      "assertions": [
        {
          "id": "runtime.self-close-rejected",
          "expect": "supervised task close is rejected before Runtime state changes and external close later succeeds",
          "test": "crates/easycon-runtime/src/runtime.rs::task_close_without_manual_binding_does_not_self_wait"
        },
        {
          "id": "runtime.task-owned",
          "expect": "Runtime owns task completion, JoinHandle, owner binding, join, and unregister without a public task registration protocol",
          "test": "crates/easycon-runtime/src/runtime.rs::task_close_without_manual_binding_does_not_self_wait"
        },
        {
          "id": "runtime.task-exit-owned",
          "expect": "task ownership remains active through TLS destruction so synchronous close is rejected before state change",
          "test": "crates/easycon-runtime/src/runtime.rs::task_exit_destructor_close_is_rejected_before_state_change"
        },
        {
          "id": "runtime.task-exit-self-join",
          "expect": "a task-owned TLS destructor cannot join its own Runtime-owned thread",
          "test": "crates/easycon-runtime/src/runtime.rs::task_exit_destructor_cannot_join_its_own_thread"
        },
        {
          "id": "runtime.task-panic-race",
          "expect": "external join cannot unlink a panicked task before its diagnostic is durable to concurrent close",
          "test": "crates/easycon-runtime/src/runtime.rs::concurrent_external_join_cannot_hide_a_task_panic_from_close"
        },
        {
          "id": "runtime.reentrant-close",
          "expect": "a resource callback on the close owner thread receives CloseOwner before waiting and the outer close still reaches its saved outcome",
          "test": "crates/easycon-runtime/src/runtime.rs::resource_callback_reentrant_close_is_rejected_without_self_wait"
        },
        {
          "id": "runtime.drop-limited",
          "expect": "final owning Drop rejects admission and requests root cancellation but runs no resource callback, starts no finalizer, and emits no RuntimeClosed",
          "test": "crates/easycon-runtime/src/runtime.rs::final_owning_drop_only_rejects_admission_and_requests_cancellation"
        },
        {
          "id": "runtime.healthy-cleanup-after-panic",
          "expect": "resource callback panic does not prevent healthy resource cleanup",
          "test": "crates/easycon-runtime/src/runtime.rs::resource_panic_saves_one_report_without_forcing_owner_terminal"
        },
        {
          "id": "runtime.saved-close-failed",
          "expect": "all concurrent and later close callers receive one saved CloseFailed outcome and runtime.close_failed is the final event",
          "test": "crates/easycon-runtime/src/runtime.rs::resource_panic_saves_one_report_without_forcing_owner_terminal"
        },
        {
          "id": "runtime.owner-terminal-order",
          "expect": "an operation remains non-terminal until its real owner cleanup and owner task exit",
          "test": "crates/easycon-runtime/src/runtime.rs::resource_panic_saves_one_report_without_forcing_owner_terminal"
        },
        {
          "id": "runtime.close-report",
          "expect": "CloseFailed retains diagnostic resource or task IDs and non-converged registry counts",
          "test": "crates/easycon-runtime/src/runtime.rs::resource_panic_saves_one_report_without_forcing_owner_terminal"
        },
        {
          "id": "runtime.final-event-failure",
          "expect": "a failed final-event transaction exposes only runtime.close_failed and never a partial runtime.closed",
          "test": "crates/easycon-runtime/src/runtime.rs::final_event_failure_never_exposes_runtime_closed"
        }
      ]
    },
    {
      "id": "operation-terminal-transaction",
      "test": "crates/easycon-runtime/src/runtime.rs::parent_terminal_seals_child_admission_before_owner_cleanup",
      "tests": [
        "crates/easycon-runtime/src/runtime.rs::parent_terminal_seals_child_admission_before_owner_cleanup",
        "crates/easycon-runtime/src/cancellation.rs::hook_panic_does_not_skip_later_hooks_or_children",
        "crates/easycon-runtime/src/runtime.rs::operation_commits_terminal_state_and_event_once",
        "crates/easycon-runtime/src/runtime.rs::terminal_faults_still_unlink_and_wake_waiters",
        "crates/easycon-runtime/src/runtime.rs::terminal_child_hook_can_observe_parent_without_deadlock",
        "crates/easycon-runtime/src/runtime.rs::poisoned_operation_registry_does_not_kill_deadline_supervision"
      ],
      "steps": [
        { "id": "operation.parent-child-race", "action": "race parent terminal start against child operation admission" },
        { "id": "operation.hook-panic", "action": "register two cancellation hooks and a child where the first hook panics" },
        { "id": "operation.hook-reentry", "action": "observe the parent operation from a child cancellation hook during terminal sealing" },
        { "id": "operation.event-fault", "action": "inject terminal event delivery failure while an operation waiter is blocked" },
        { "id": "operation.registry-fault", "action": "inject operation registry unlink failure while a second waiter is blocked" },
        { "id": "operation.poison-recovery", "action": "poison each recoverable Runtime synchronization lock before retrying its operation" }
      ],
      "assertions": [
        {
          "id": "operation.child-admission",
          "expect": "child admission linearized after parent terminal sealing is rejected and an earlier child is cancelled",
          "test": "crates/easycon-runtime/src/runtime.rs::parent_terminal_seals_child_admission_before_owner_cleanup"
        },
        {
          "id": "operation.hook-panic-isolated",
          "expect": "one cancellation hook panic does not skip later hooks or any live child",
          "test": "crates/easycon-runtime/src/cancellation.rs::hook_panic_does_not_skip_later_hooks_or_children"
        },
        {
          "id": "operation.immutable-terminal",
          "expect": "terminal state and payload are immutable and committed exactly once after owner cleanup",
          "test": "crates/easycon-runtime/src/runtime.rs::operation_commits_terminal_state_and_event_once"
        },
        {
          "id": "operation.unlink-before-wake",
          "expect": "registry unlink occurs before every terminal waiter returns",
          "test": "crates/easycon-runtime/src/runtime.rs::terminal_faults_still_unlink_and_wake_waiters"
        },
        {
          "id": "operation.failure-notify",
          "expect": "event, registry, hook, and poisoned-lock faults cannot suppress waiter notification",
          "test": "crates/easycon-runtime/src/runtime.rs::terminal_faults_still_unlink_and_wake_waiters"
        },
        {
          "id": "operation.reentrant-hook",
          "expect": "a child cancellation hook can observe its parent without deadlocking terminal commit, unlink, or waiter notification",
          "test": "crates/easycon-runtime/src/runtime.rs::terminal_child_hook_can_observe_parent_without_deadlock"
        },
        {
          "id": "operation.poison-recovery",
          "expect": "a poisoned operation registry is recovered without killing deadline supervision or changing successful close",
          "test": "crates/easycon-runtime/src/runtime.rs::poisoned_operation_registry_does_not_kill_deadline_supervision"
        }
      ]
    },
    {
      "id": "timeout-separation",
      "test": "crates/easycon-runtime/src/runtime.rs::wait_timeout_does_not_cancel_operation",
      "tests": [
        "crates/easycon-runtime/src/runtime.rs::wait_timeout_does_not_cancel_operation",
        "crates/easycon-runtime/src/runtime.rs::deadline_requests_cancel_but_cleanup_owns_terminal_commit",
        "tests/support/tests/controller_lane.rs::handshake_protocol_timeout_is_failed_not_cancelled",
        "tests/support/tests/sequence_ack.rs::blocked_ack_obeys_its_protocol_deadline",
        "tests/support/tests/sequence_ack.rs::blocked_report_write_obeys_its_io_deadline"
      ],
      "steps": [
        { "id": "timeout.poll", "action": "poll a running operation with zero wait timeout" },
        { "id": "timeout.deadline", "action": "advance past an operation deadline without manually polling Runtime" },
        { "id": "timeout.handshake", "action": "inject a handshake protocol timeout in a separate operation" },
        { "id": "timeout.ack", "action": "block an ACK wait until its protocol deadline" },
        { "id": "timeout.write", "action": "block a report write until its independent I/O deadline" }
      ],
      "assertions": [
        {
          "id": "timeout.wait-does-not-cancel",
          "expect": "wait timeout leaves the operation Running",
          "test": "crates/easycon-runtime/src/runtime.rs::wait_timeout_does_not_cancel_operation"
        },
        {
          "id": "timeout.deadline-cancels",
          "expect": "deadline requests cancellation and finishes Cancelled after cleanup",
          "test": "crates/easycon-runtime/src/runtime.rs::deadline_requests_cancel_but_cleanup_owns_terminal_commit"
        },
        {
          "id": "timeout.protocol-fails",
          "expect": "protocol timeout finishes Failed with controller error",
          "test": "tests/support/tests/controller_lane.rs::handshake_protocol_timeout_is_failed_not_cancelled"
        },
        {
          "id": "timeout.ack-fails",
          "expect": "a blocked ACK finishes Failed when its protocol deadline elapses",
          "test": "tests/support/tests/sequence_ack.rs::blocked_ack_obeys_its_protocol_deadline"
        },
        {
          "id": "timeout.write-fails",
          "expect": "write timeout finishes Failed with transport error",
          "test": "tests/support/tests/sequence_ack.rs::blocked_report_write_obeys_its_io_deadline"
        }
      ]
    },
    {
      "id": "transport-faults",
      "test": "tests/support/tests/controller_lane.rs::fallback_connect_partial_direct_and_close_are_exact",
      "tests": [
        "tests/support/tests/controller_lane.rs::fallback_connect_partial_direct_and_close_are_exact",
        "tests/support/tests/sequence_ack.rs::ack_matcher_ignores_late_generation_and_rejects_wrong_reply",
        "tests/support/tests/sequence_ack.rs::ack_waits_for_an_earlier_report_in_the_fifo_lane",
        "tests/support/tests/sequence_ack.rs::cancel_after_final_sequence_acceptance_still_neutralizes",
        "tests/support/tests/controller_lane.rs::report_spacing_and_snapshot_use_transport_acceptance_time",
        "tests/support/tests/sequence_ack.rs::close_interrupts_a_blocked_report_write_and_joins",
        "tests/support/tests/sequence_ack.rs::ack_disconnect_resets_desired_state_before_explicit_reconnect",
        "tests/support/tests/sequence_ack.rs::sequence_disconnect_releases_lease_and_exposes_neutral_warning",
        "tests/support/tests/sequence_ack.rs::close_cancels_blocked_ack_and_joins_lane"
      ],
      "steps": [
        { "id": "transport.partial-write", "action": "accept a report using partial writes" },
        { "id": "transport.late-ack", "action": "ignore a late ACK from an older generation" },
        { "id": "transport.error-ack", "action": "reject an error ACK" },
        { "id": "transport.ack-after-report", "action": "queue an ACK behind a report that is waiting for its minimum interval" },
        { "id": "transport.accepted-cancel", "action": "cancel after direct and final sequence bytes are accepted but before write returns" },
        { "id": "transport.close-after-report", "action": "close immediately after an accepted report" },
        { "id": "transport.close-blocked-write", "action": "close while a report write is blocked before acceptance" },
        { "id": "transport.ack-disconnect", "action": "disconnect during an ACK and reconnect explicitly" },
        { "id": "transport.sequence-disconnect", "action": "disconnect during a sequence" },
        { "id": "transport.close-blocked-ack", "action": "close while an ACK read is blocked" }
      ],
      "assertions": [
        {
          "id": "transport.bytes-exact",
          "expect": "bytes are neither duplicated nor truncated",
          "test": "tests/support/tests/controller_lane.rs::fallback_connect_partial_direct_and_close_are_exact"
        },
        {
          "id": "transport.late-ack-isolated",
          "expect": "late ACK cannot complete the current operation",
          "test": "tests/support/tests/sequence_ack.rs::ack_matcher_ignores_late_generation_and_rejects_wrong_reply"
        },
        {
          "id": "transport.ack-fifo",
          "expect": "ACK waits for the earlier report instead of returning resource busy",
          "test": "tests/support/tests/sequence_ack.rs::ack_waits_for_an_earlier_report_in_the_fifo_lane"
        },
        {
          "id": "transport.accepted-cancel-terminal",
          "expect": "accepted-byte cancellation neutralizes and reaches Cancelled exactly once",
          "test": "tests/support/tests/sequence_ack.rs::cancel_after_final_sequence_acceptance_still_neutralizes"
        },
        {
          "id": "transport.close-spacing",
          "expect": "the close neutral report waits for the same minimum report interval",
          "test": "tests/support/tests/controller_lane.rs::report_spacing_and_snapshot_use_transport_acceptance_time"
        },
        {
          "id": "transport.close-interrupts-write",
          "expect": "close interrupts blocked write and joins the lane",
          "test": "tests/support/tests/sequence_ack.rs::close_interrupts_a_blocked_report_write_and_joins"
        },
        {
          "id": "transport.ack-disconnect-reset",
          "expect": "ACK disconnect resets desired state and closes transport before reconnect",
          "test": "tests/support/tests/sequence_ack.rs::ack_disconnect_resets_desired_state_before_explicit_reconnect"
        },
        {
          "id": "transport.disconnect-warning",
          "expect": "disconnect fails pending work and exposes neutralization warning",
          "test": "tests/support/tests/sequence_ack.rs::sequence_disconnect_releases_lease_and_exposes_neutral_warning"
        },
        {
          "id": "transport.close-wakes-ack",
          "expect": "transport close wakes the blocked read and the lane joins",
          "test": "tests/support/tests/sequence_ack.rs::close_cancels_blocked_ack_and_joins_lane"
        }
      ]
    },
    {
      "id": "event-overflow",
      "test": "crates/easycon-runtime/src/runtime.rs::queue_overflow_reports_gap_without_blocking_or_changing_state",
      "tests": [
        "crates/easycon-runtime/src/runtime.rs::queue_overflow_reports_gap_without_blocking_or_changing_state",
        "crates/easycon-runtime/src/runtime.rs::gap_remains_between_earlier_critical_and_later_event",
        "crates/easycon-runtime/src/runtime.rs::concurrent_publishers_enqueue_in_global_sequence_order",
        "crates/easycon-runtime/src/runtime.rs::capacity_one_preserves_latest_terminal_and_query_is_authoritative",
        "crates/easycon-runtime/src/runtime.rs::final_runtime_event_bypasses_subscription_severity_filter"
      ],
      "steps": [
        { "id": "event.capacity-one", "action": "create a capacity-one subscription" },
        { "id": "event.overflow", "action": "publish more ordinary events than capacity" },
        { "id": "event.critical-retained", "action": "retain an earlier critical event while a later ordinary event is dropped" },
        { "id": "event.concurrent-publish", "action": "publish concurrently from multiple producers" },
        { "id": "event.operation-complete", "action": "complete an operation" },
        { "id": "event.read-and-query", "action": "read the subscription and query the operation" },
        { "id": "event.filtered-close", "action": "close Runtime with a second subscription whose severity filter excludes Info" }
      ],
      "assertions": [
        {
          "id": "event.gap-range",
          "expect": "EventGap reports the dropped sequence interval",
          "test": "crates/easycon-runtime/src/runtime.rs::queue_overflow_reports_gap_without_blocking_or_changing_state"
        },
        {
          "id": "event.sequence-order",
          "expect": "concrete events and gaps are read in strictly increasing sequence order",
          "test": "crates/easycon-runtime/src/runtime.rs::gap_remains_between_earlier_critical_and_later_event"
        },
        {
          "id": "event.producer-nonblocking",
          "expect": "producer never blocks",
          "test": "crates/easycon-runtime/src/runtime.rs::concurrent_publishers_enqueue_in_global_sequence_order"
        },
        {
          "id": "event.query-authoritative",
          "expect": "authoritative terminal state remains queryable",
          "test": "crates/easycon-runtime/src/runtime.rs::capacity_one_preserves_latest_terminal_and_query_is_authoritative"
        },
        {
          "id": "event.final-bypasses-filter",
          "expect": "RuntimeClosed bypasses the severity filter and remains the final event",
          "test": "crates/easycon-runtime/src/runtime.rs::final_runtime_event_bypasses_subscription_severity_filter"
        }
      ]
    }
  ]
}
