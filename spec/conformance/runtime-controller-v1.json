    {
      "id": "phase2a-serial",
      "test": "crates/easycon-serial/src/discovery.rs::stable_identity_is_independent_from_optional_labels_and_port_assignment",
      "tests": [
        "crates/easycon-serial/src/discovery.rs::stable_identity_is_independent_from_optional_labels_and_port_assignment",
        "crates/easycon-serial/src/windows/discovery.rs::usb_ids_come_only_from_explicit_hardware_id_components",
        "crates/easycon-serial/src/windows/discovery.rs::live_discovery_is_sorted_and_has_stable_identity",
        "crates/easycon-serial/src/windows/io.rs::port_paths_are_canonical_and_do_not_open_arbitrary_devices",
        "crates/easycon-serial/src/windows/io.rs::close_signal_is_idempotent_and_wakes_waiters",
        "crates/easycon-serial/src/windows/io.rs::explicit_interruption_overrides_only_a_native_aborted_completion",
        "crates/easycon-serial/src/windows/io.rs::unwind_cleanup_runs_before_the_original_panic_is_resumed",
        "crates/easycon-serial/tests/byte_io_contract.rs::injectable_adapter_handles_partial_handshake_and_command_generation",
        "tests/support/tests/serial_ch32.rs::serial_adapter_fallback_partial_report_and_close_are_byte_exact",
        "tests/support/tests/serial_ch32.rs::access_denied_and_port_busy_open_failures_are_bounded_and_leak_free",
        "tests/support/tests/serial_ch32.rs::byte_ack_delay_duplicate_wrong_reply_and_zero_progress_are_isolated",
        "tests/support/tests/serial_ch32.rs::blocked_ack_obeys_deadline_and_controller_close_wakes_a_second_wait",
        "tests/support/tests/serial_ch32.rs::hot_unplug_and_mid_payload_failure_close_the_stream_without_continuation",
        "tests/support/tests/serial_ch32.rs::failed_cancel_neutral_closes_the_serial_stream_before_terminal"
