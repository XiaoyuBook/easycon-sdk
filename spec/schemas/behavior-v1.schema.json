{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easycon.invalid/schemas/behavior-v1.schema.json",
  "title": "EasyCon runtime/controller behavior v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "milestone",
    "license",
    "phase2a",
    "operations",
    "runtime",
    "events",
    "controller",
    "classifications"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "milestone": { "const": "phase-2a-controller-serial-candidate-v1" },
    "license": { "const": "GPL-3.0-only" },
    "phase2a": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "hardware_verified", "open_risks", "excluded_scope"],
      "properties": {
        "status": { "const": "Hardware Unverified" },
        "hardware_verified": { "const": false },
        "open_risks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["O-01", "O-02", "O-04"] }
        },
        "excluded_scope": { "type": "string" }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "terminal_states", "transitions", "timeouts", "terminal_commit", "terminal_transaction"],
      "properties": {
        "states": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "terminal_states": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "cause"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "cause": { "type": "string" }
            }
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wait_timeout",
            "operation_deadline",
            "protocol_timeout",
            "transport_write_timeout"
          ],
          "properties": {
            "wait_timeout": { "type": "string" },
            "operation_deadline": { "type": "string" },
            "protocol_timeout": { "type": "string" },
            "transport_write_timeout": { "type": "string" }
          }
        },
        "terminal_commit": { "type": "string" },
        "terminal_transaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent",
            "claim",
            "child_admission",
            "order",
            "cleanup_projection",
            "handoff",
            "ownership_loss",
            "failure_isolation"
          ],
          "properties": {
            "intent": { "type": "string" },
            "claim": { "type": "string" },
            "child_admission": { "type": "string" },
            "order": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "cleanup_projection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["success", "failure", "cancellation"],
              "properties": {
                "success": { "type": "string" },
                "failure": { "type": "string" },
                "cancellation": { "type": "string" }
              }
            },
            "handoff": { "type": "string" },
            "ownership_loss": { "type": "string" },
            "failure_isolation": { "type": "string" }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "close_is_idempotent", "explicit_close", "reentrant_close", "final_handle_drop", "supervised_tasks", "close_failure", "generic_deadlines", "close_order", "closed_counts"],
      "properties": {
        "states": { "type": "array", "minItems": 4, "items": { "type": "string" }, "uniqueItems": true },
        "close_is_idempotent": { "type": "boolean" },
        "explicit_close": { "type": "string" },
        "reentrant_close": { "type": "string" },
        "final_handle_drop": { "type": "string" },
        "supervised_tasks": { "type": "string" },
        "close_failure": { "type": "string" },
        "generic_deadlines": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "identity",
            "states",
            "independence",
            "system_clock",
            "virtual_clock",
            "close"
          ],
          "properties": {
            "target": { "type": "string" },
            "identity": { "type": "string" },
            "states": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "enum": ["Armed", "Fired", "Disarmed", "RuntimeClosed"] }
            },
            "independence": { "type": "string" },
            "system_clock": { "type": "string" },
            "virtual_clock": { "type": "string" },
            "close": { "type": "string" }
          }
        },
        "close_order": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "closed_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active_tasks", "active_resources", "active_operations"],
          "properties": {
            "active_tasks": { "type": "integer", "minimum": 0 },
            "active_resources": { "type": "integer", "minimum": 0 },
            "active_operations": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery", "single_reader", "sequence", "overflow", "close"],
      "properties": {
        "delivery": { "type": "string" },
        "single_reader": { "type": "string" },
        "sequence": { "type": "string" },
        "overflow": { "type": "string" },
        "close": { "type": "string" }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_writer",
        "default_minimum_report_interval_ns",
        "report_interval_scope",
        "write_timeout_ns",
        "direct_success_boundary",
        "hardware_execution_claimed",
        "serial",
        "amiibo",
        "timing",
        "sequence",
        "automation_lease"
      ],
      "properties": {
        "single_writer": { "type": "boolean" },
        "default_minimum_report_interval_ns": { "type": "integer", "minimum": 1 },
        "report_interval_scope": { "type": "string" },
        "write_timeout_ns": { "type": "integer", "minimum": 1 },
        "direct_success_boundary": { "type": "string" },
        "hardware_execution_claimed": { "type": "boolean" },
        "serial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "system_leaf",
            "identity",
            "optional_properties",
            "io",
            "close",
            "dependency_direction"
          ],
          "properties": {
            "platform": { "const": "Windows 10/11 x64" },
            "system_leaf": { "const": true },
            "identity": { "type": "string" },
            "optional_properties": { "type": "string" },
            "io": { "type": "string" },
            "close": { "type": "string" },
            "dependency_direction": { "type": "string" }
          }
        },
        "amiibo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chunk_size",
            "save_command",
            "select_command",
            "ack",
            "generation_matched",
            "retry",
            "limits",
            "cleanup"
          ],
          "properties": {
            "chunk_size": { "const": 20 },
            "save_command": { "const": 144 },
            "select_command": { "const": 145 },
            "ack": { "const": 255 },
            "generation_matched": { "const": true },
            "retry": { "type": "string" },
            "limits": { "type": "string" },
            "cleanup": { "type": "string" }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stages",
            "eligible_direct_samples",
            "target_p99_ns",
            "target_max_ns",
            "software_path_only",
            "outlier_filtering",
            "permanent_busy_wait"
          ],
          "properties": {
            "stages": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "command_admitted",
                  "lane_wake",
                  "lane_dispatch",
                  "transport_write_entered",
                  "transport_accepted"
                ]
              }
            },
            "eligible_direct_samples": { "const": 10000 },
            "target_p99_ns": { "const": 1000000 },
            "target_max_ns": { "const": 5000000 },
            "software_path_only": { "const": true },
            "outlier_filtering": { "const": false },
            "permanent_busy_wait": { "const": false }
          }
        },
        "sequence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "offsets",
            "same_offset",
            "early_dispatch",
            "drift",
            "cancel_or_failure",
            "maximum_steps",
            "phase2a_acceptance"
          ],
          "properties": {
            "origin": { "type": "string" },
            "offsets": { "type": "string" },
            "same_offset": { "type": "string" },
            "early_dispatch": { "type": "boolean" },
            "drift": { "type": "string" },
            "cancel_or_failure": { "type": "string" },
            "maximum_steps": { "const": 10000 },
            "phase2a_acceptance": { "type": "string" }
          }
        },
        "automation_lease": { "type": "string" }
      }
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classification", "rule"],
        "properties": {
          "id": { "type": "string" },
          "classification": { "enum": ["source-exact", "corrected"] },
          "rule": { "type": "string" }
        }
      }
    }
  }
}
