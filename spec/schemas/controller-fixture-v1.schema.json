{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easycon.invalid/schemas/controller-fixture-v1.schema.json",
  "title": "EasyCon source-exact controller protocol fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "license",
    "provenance",
    "buttons",
    "hats",
    "sticks",
    "handshake",
    "amiibo",
    "reports",
    "corrected_behaviors"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "classification": { "const": "source-exact" },
    "license": { "const": "GPL-3.0-only" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_role", "evidence"],
      "properties": {
        "snapshot_role": { "type": "string" },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "buttons": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 8192 } },
    "hats": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 8 } },
    "sticks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "center", "maximum"],
      "properties": {
        "minimum": { "const": 0 },
        "center": { "const": 128 },
        "maximum": { "const": 255 }
      }
    },
    "handshake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_baud_order", "request", "success_reply"],
      "properties": {
        "auto_baud_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        },
        "request": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "success_reply": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "amiibo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["save", "select", "reset", "hardware_limits"],
      "properties": {
        "save": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ready", "command", "chunk_size", "header_example", "ack", "ack_timeout_ms"],
          "properties": {
            "ready": { "const": 165 },
            "command": { "const": 144 },
            "chunk_size": { "const": 20 },
            "header_example": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": { "type": "integer", "minimum": 0, "maximum": 255 }
            },
            "ack": { "const": 255 },
            "ack_timeout_ms": { "const": 1000 }
          }
        },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ready", "command", "request_example", "ack", "ack_timeout_ms"],
          "properties": {
            "ready": { "const": 165 },
            "command": { "const": 145 },
            "request_example": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "integer", "minimum": 0, "maximum": 255 }
            },
            "ack": { "const": 255 },
            "ack_timeout_ms": { "const": 200 }
          }
        },
        "reset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request", "reply", "timeout_ms"],
          "properties": {
            "request": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": { "type": "integer", "minimum": 0, "maximum": 255 }
            },
            "reply": { "const": 128 },
            "timeout_ms": { "const": 50 }
          }
        },
        "hardware_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slot_count", "maximum_data_len", "verified"],
          "properties": {
            "slot_count": { "type": "null" },
            "maximum_data_len": { "type": "null" },
            "verified": { "const": false }
          }
        }
      }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state", "encoded"],
        "properties": {
          "name": { "type": "string" },
          "state": {
            "type": "object",
            "additionalProperties": false,
            "required": ["button_mask", "hat", "lx", "ly", "rx", "ry"],
            "properties": {
              "button_mask": { "type": "integer", "minimum": 0, "maximum": 16383 },
              "hat": { "type": "integer", "minimum": 0, "maximum": 8 },
              "lx": { "type": "integer", "minimum": 0, "maximum": 255 },
              "ly": { "type": "integer", "minimum": 0, "maximum": 255 },
              "rx": { "type": "integer", "minimum": 0, "maximum": 255 },
              "ry": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          },
          "encoded": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        }
      }
    },
    "corrected_behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classification", "source_observation", "required_behavior"],
        "properties": {
          "id": { "type": "string" },
          "classification": { "const": "corrected" },
          "source_observation": { "type": "string" },
          "required_behavior": { "type": "string" }
        }
      }
    }
  }
}
