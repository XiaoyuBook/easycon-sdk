{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easycon.invalid/schemas/conformance-v1.schema.json",
  "title": "EasyCon runtime/controller conformance fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "milestone", "license", "scenarios"],
  "properties": {
    "schema_version": { "const": 1 },
    "milestone": { "const": "phase-2a-controller-serial-candidate-v1" },
    "license": { "const": "GPL-3.0-only" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "test", "tests", "steps", "assertions"],
        "properties": {
          "id": { "type": "string" },
          "test": { "type": "string" },
          "tests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "action"],
              "properties": {
                "id": { "type": "string" },
                "action": { "type": "string" }
              }
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "expect", "test"],
              "properties": {
                "id": { "type": "string" },
                "expect": { "type": "string" },
                "test": { "type": "string" }
              }
            }
          },
          "obligations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "adr", "expect", "test", "marker"],
              "properties": {
                "id": { "type": "string" },
                "adr": { "type": "string" },
                "expect": { "type": "string" },
                "test": { "type": "string" },
                "marker": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
